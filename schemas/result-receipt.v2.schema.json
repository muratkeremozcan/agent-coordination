{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-coordination/result-receipt.v2",
  "title": "Owner result receipt, schema v3 ledger: carries its owner and evidence source",
  "type": "object",
  "required": [
    "request_id",
    "generation",
    "owner",
    "source",
    "outcome"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_sha": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer",
          "status"
        ],
        "properties": {
          "reviewer": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "findings",
              "blocked",
              "not-run",
              "unavailable"
            ]
          }
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reply-correlated",
            "runtime-read",
            "text-correlated",
            "coordinator-observed"
          ]
        },
        "identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision_inventory": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "schema": {
      "const": 2
    }
  }
}
